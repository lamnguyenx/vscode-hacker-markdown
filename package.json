{
	"name": "hacker-markdown",
	"displayName": "Hacker Markdown",
	"description": "A Markdown preview you can dock in the Panel, Primary Side Bar, or Secondary Side Bar, open in the Editor, move to a new window, or toggle over the Markdown tab in place.",
	"version": "2026.11.6",
	"publisher": "lamnguyenx",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lamnguyenx/vscode-hacker-markdown.git"
	},
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onView:hackerMarkdown.preview",
		"onView:hackerMarkdown.previewPrimary",
		"onView:hackerMarkdown.previewSecondary",
		"onCustomEditor:hackerMarkdown.previewEditor",
		"onCommand:hackerMarkdown.open",
		"onCommand:hackerMarkdown.openInPrimarySidebar",
		"onCommand:hackerMarkdown.openInSecondarySidebar",
		"onCommand:hackerMarkdown.openInEditor",
		"onCommand:hackerMarkdown.openInNewWindow",
		"onCommand:hackerMarkdown.togglePreview",
		"onCommand:hackerMarkdown.reopenAsSource",
		"onCommand:hackerMarkdown.refresh",
		"onWebviewPanel:hackerMarkdown.panel",
		"onLanguage:markdown"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languages": [
			{
				"id": "plantuml",
				"extensions": [
					".wsd",
					".pu",
					".puml",
					".plantuml",
					".iuml"
				],
				"aliases": [
					"PlantUML"
				],
				"configuration": "./syntaxes/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "plantuml",
				"scopeName": "source.wsd",
				"path": "./syntaxes/plantuml.tmLanguage.json"
			},
			{
				"scopeName": "markdown.hackermarkdown.plantuml.codeblock",
				"path": "./syntaxes/codeblock.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.plantuml": "plantuml"
				}
			}
		],
		"configuration": {
			"title": "Hacker Markdown",
			"properties": {
				"hackerMarkdown.scrollPreviewWithEditor": {
					"type": "boolean",
					"default": true,
					"description": "When the cursor moves in the Markdown editor, scroll the preview to the matching line."
				},
				"hackerMarkdown.scrollEditorWithPreview": {
					"type": "boolean",
					"default": true,
					"description": "When the preview is scrolled, scroll the Markdown editor to the matching line."
				},
				"hackerMarkdown.cursorPreviewWithEditor": {
					"type": "boolean",
					"default": true,
					"description": "When the cursor moves in the Markdown editor, highlight the matching line in the preview with a blue outline box."
				},
				"hackerMarkdown.clickToSource": {
					"type": "boolean",
					"default": true,
					"description": "When a block is clicked in the preview, move the editor cursor to the matching source line."
				},
				"hackerMarkdown.styles": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Custom CSS files applied to the preview. Accepts file:// URLs, absolute paths, and https URLs; relative paths are resolved against the Markdown file's folder."
				},
				"hackerMarkdown.renderOnSave": {
					"type": "boolean",
					"default": true,
					"description": "Re-render the preview only when the Markdown document is saved. When disabled, the preview re-renders live (debounced) as you type."
				},
				"hackerMarkdown.plantuml.server": {
					"type": "string",
					"scope": "machine-overridable",
					"default": "http://localhost:9274",
					"description": "PlantUML server used to render `puml`/`plantuml`/`uml` fences in the preview as SVG images. Defaults to http://localhost:9274 (the `plantuml/docker-compose.yml` stack). Set another URL to use a different server; set empty to disable diagram rendering."
				},
				"hackerMarkdown.plantuml.includepaths": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"scope": "resource",
					"default": [],
					"description": "Additional folders to resolve `!include` / `!includesub` directives against, beyond the Markdown file's own folder."
				},
				"hackerMarkdown.completions.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Offer PlantUML keyword suggestions while typing inside `plantuml`/`puml`/`uml` code fences in Markdown files."
				},
				"hackerMarkdown.media.invert": {
					"type": "string",
					"enum": [
						"auto",
						"dark",
						"light",
						"off"
					],
					"default": "auto",
					"description": "Invert media (images, diagrams, video) in the preview. `auto` inverts only in dark themes. Toggle from the preview toolbar."
				},
				"hackerMarkdown.media.columnWidth": {
					"type": "string",
					"default": "100%",
					"description": "Reading column width, any CSS length (e.g. `700px`, `45vw`, `100%`). Set from the preview toolbar input; reset restores `100%`."
				},
				"hackerMarkdown.media.tables": {
					"type": "string",
					"enum": [
						"pan",
						"fit"
					],
					"default": "pan",
					"description": "Wide table handling in the preview. `pan` makes each table scroll horizontally inside its own region; `fit` wraps to the column. Toggle from the preview toolbar."
				},
				"hackerMarkdown.media.zoom": {
					"type": "number",
					"default": 100,
					"minimum": 50,
					"maximum": 200,
					"description": "Preview zoom level (50–200%). Set from the preview toolbar −/+/reset buttons; Ctrl+=/Ctrl+-/Ctrl+0 also work when the preview is focused."
				},
				"hackerMarkdown.overridePreviewShortcut": {
					"type": "boolean",
					"default": true,
					"description": "Override the built-in preview shortcut (Ctrl/Cmd+Shift+V) so it runs `Hacker Markdown: Toggle Preview` instead of the built-in preview. When disabled, Ctrl/Cmd+Shift+V runs the built-in preview command. The Ctrl/Cmd+K Ctrl/Cmd+V chord always toggles the Hacker Markdown preview."
				}
			}
		},
		"viewsContainers": {
			"panel": [
				{
					"id": "hacker-markdown",
					"title": "Hacker Markdown",
					"icon": "build/icon.svg"
				}
			],
			"activitybar": [
				{
					"id": "hacker-markdown-primary",
					"title": "Hacker Markdown",
					"icon": "build/icon.svg"
				}
			],
			"secondarySidebar": [
				{
					"id": "hacker-markdown-secondary",
					"title": "Hacker Markdown",
					"icon": "build/icon.svg"
				}
			]
		},
		"views": {
			"hacker-markdown": [
				{
					"type": "webview",
					"id": "hackerMarkdown.preview",
					"name": "Markdown Preview",
					"icon": "build/icon.svg",
					"contextualTitle": "Hacker Markdown"
				}
			],
			"hacker-markdown-primary": [
				{
					"type": "webview",
					"id": "hackerMarkdown.previewPrimary",
					"name": "Markdown Preview",
					"icon": "build/icon.svg",
					"contextualTitle": "Hacker Markdown"
				}
			],
			"hacker-markdown-secondary": [
				{
					"type": "webview",
					"id": "hackerMarkdown.previewSecondary",
					"name": "Markdown Preview",
					"icon": "build/icon.svg",
					"contextualTitle": "Hacker Markdown"
				}
			]
		},
		"customEditors": [
			{
				"viewType": "hackerMarkdown.previewEditor",
				"displayName": "Hacker Markdown Preview",
				"priority": {
					"diffEditor": "option",
					"textEditor": "option"
				},
				"selector": [
					{
						"filenamePattern": "*.{md,mkd,mkdn,mdwn,mdown,markdown,markdn,mdtxt,mdtext,litcoffee,ron,ronn,workbook}"
					}
				]
			}
		],
		"commands": [
			{
				"command": "hackerMarkdown.open",
				"title": "Hacker Markdown: Open in Panel"
			},
			{
				"command": "hackerMarkdown.openInPrimarySidebar",
				"title": "Hacker Markdown: Open in Primary Side Bar"
			},
			{
				"command": "hackerMarkdown.openInSecondarySidebar",
				"title": "Hacker Markdown: Open in Secondary Side Bar"
			},
			{
				"command": "hackerMarkdown.openInEditor",
				"title": "Hacker Markdown: Open Preview in Editor"
			},
			{
				"command": "hackerMarkdown.openInNewWindow",
				"title": "Hacker Markdown: Open Preview in New Window"
			},
			{
				"command": "hackerMarkdown.togglePreview",
				"title": "Hacker Markdown: Toggle Preview",
				"icon": "$(preview)"
			},
			{
				"command": "hackerMarkdown.reopenAsSource",
				"title": "Hacker Markdown: Show Source",
				"icon": "$(file-code)"
			},
			{
				"command": "hackerMarkdown.refresh",
				"title": "Hacker Markdown: Refresh Preview"
			}
		],
		"keybindings": [
			{
				"command": "hackerMarkdown.open",
				"key": "ctrl+alt+shift+h",
				"when": "editorFocus && !terminalFocus"
			},
			{
				"command": "hackerMarkdown.togglePreview",
				"key": "shift+ctrl+v",
				"mac": "shift+cmd+v",
				"when": "config.hackerMarkdown.overridePreviewShortcut && !terminalFocus && ((editorFocus && resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused) || activeCustomEditorId == 'hackerMarkdown.previewEditor')"
			},
			{
				"command": "hackerMarkdown.togglePreview",
				"key": "ctrl+k ctrl+v",
				"mac": "cmd+k cmd+v",
				"when": "!terminalFocus && ((editorFocus && resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused) || activeCustomEditorId == 'hackerMarkdown.previewEditor')"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "hackerMarkdown.open"
				},
				{
					"command": "hackerMarkdown.openInPrimarySidebar"
				},
				{
					"command": "hackerMarkdown.openInSecondarySidebar"
				},
				{
					"command": "hackerMarkdown.openInEditor"
				},
				{
					"command": "hackerMarkdown.openInNewWindow"
				},
				{
					"command": "hackerMarkdown.togglePreview"
				},
				{
					"command": "hackerMarkdown.reopenAsSource"
				},
				{
					"command": "hackerMarkdown.refresh"
				}
			],
			"editor/title": [
				{
					"command": "hackerMarkdown.togglePreview",
					"when": "resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/ && !notebookEditorFocused",
					"group": "navigation@1"
				},
				{
					"command": "hackerMarkdown.reopenAsSource",
					"when": "activeCustomEditorId == 'hackerMarkdown.previewEditor'",
					"group": "navigation@1"
				}
			],
			"editor/title/context": [
				{
					"command": "hackerMarkdown.togglePreview",
					"when": "resourceLangId =~ /^(markdown|prompt|instructions|chatagent|skill)$/",
					"group": "navigation"
				},
				{
					"command": "hackerMarkdown.reopenAsSource",
					"when": "activeCustomEditorId == 'hackerMarkdown.previewEditor'",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"build:syntax": "node scripts/build-syntax.cjs",
		"build:webview": "esbuild src/webview/main.ts --bundle --format=iife --target=es2020 --outfile=build/index.js",
		"build:webview-assets": "node scripts/copy-webview-assets.cjs",
		"watch:webview": "esbuild src/webview/main.ts --bundle --format=iife --target=es2020 --outfile=build/index.js --watch",
		"compile": "npm run build:syntax && npm run build:webview && npm run build:webview-assets && tsc -p ./ && tsc -p tsconfig.webview.json",
		"watch": "tsc -w -p ./",
		"test:units": "bun tests/units/plantuml_check.ts && bun tests/units/plantuml_inline_check.ts && bun tests/units/plantuml_completion_check.ts && bun tests/units/plantuml_definition_check.ts && bun tests/units/mermaid_check.ts",
		"typecheck:tests": "tsc -p tsconfig.tests.json",
		"test:e2e": "playwright test --config playwright.config.ts",
		"vscode:prepublish": "npm run compile"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@types/node": "^26.1.2",
		"@types/vscode": "^1.100.0",
		"esbuild": "^0.28.1",
		"js-yaml": "^5.2.3",
		"typescript": "^5.5.0"
	},
	"directories": {
		"doc": "docs",
		"test": "tests"
	},
	"dependencies": {
		"argparse": "^2.0.1",
		"undici-types": "^8.3.0"
	},
	"keywords": [],
	"author": "",
	"type": "commonjs",
	"bugs": {
		"url": "https://github.com/lamnguyenx/vscode-hacker-markdown/issues"
	},
	"homepage": "https://github.com/lamnguyenx/vscode-hacker-markdown#readme"
}
